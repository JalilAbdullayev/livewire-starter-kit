includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Used by Livewire MFC anonymous classes under resources/views/pages (not in paths).
    ignoreErrors:
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/LoadsSiteContentPage.php
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/RendersSitePage.php
